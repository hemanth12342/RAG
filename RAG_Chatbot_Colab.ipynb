    ".dot-red{background:var(--accent-2);box-shadow:0 0 6px var(--accent-2);}\n",
    ".metric-row{display:flex;gap:10px;flex-wrap:wrap;margin:12px 0;}\n",
    ".metric-card{flex:1;min-width:80px;background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:12px 14px;text-align:center;}\n",
    ".metric-value{font-family:\\'Syne\\',sans-serif;font-size:1.4rem;font-weight:700;color:var(--accent);}\n",
    ".metric-label{font-size:.68rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:.08em;margin-top:2px;}\n",
    "[data-testid=\"stFileUploader\"]{background:var(--bg-card)!important;border:1px dashed var(--border)!important;border-radius:var(--radius)!important;}\n",
    "[data-testid=\"stChatInput\"] textarea{background:var(--bg-card)!important;border:1px solid var(--border)!important;border-radius:10px!important;color:var(--text-primary)!important;}\n",
    "[data-testid=\"stExpander\"]{background:var(--bg-card)!important;border:1px solid var(--border)!important;border-radius:var(--radius)!important;}\n",
    "hr{border-color:var(--border)!important;}\n",
    "::-webkit-scrollbar{width:5px;} ::-webkit-scrollbar-track{background:var(--bg-primary);} ::-webkit-scrollbar-thumb{background:var(--border);border-radius:10px;}\n",
    "</style>\n",
    "\"\"\", unsafe_allow_html=True)\n",
    "\n",
    "\n",
    "def init_session_state():\n",
    "    defaults = {\n",
    "        \"messages\": [], \"vector_store\": None, \"rag_chain\": None,\n",
    "        \"doc_metadata\": [], \"total_chunks\": 0, \"api_key_valid\": False,\n",
    "    }\n",
    "    for k, v in defaults.items():\n",
    "        if k not in st.session_state:\n",
    "            st.session_state[k] = v\n",
    "\n",
    "init_session_state()\n",
    "\n",
    "\n",
    "# ── Sidebar ───────────────────────────────────────────────────────────────────\n",
    "with st.sidebar:\n",
    "    st.markdown(\"### 🔑 Configuration\")\n",
    "    api_key = st.text_input(\"Groq API Key\", type=\"password\",\n",
    "                            value=os.getenv(\"GROQ_API_KEY\", \"\"),\n",
    "                            placeholder=\"gsk_...\",\n",
    "                            help=\"Get your free key at console.groq.com\")\n",
    "    if api_key:\n",
    "        os.environ[\"GROQ_API_KEY\"] = api_key\n",
    "        st.session_state.api_key_valid = validate_api_key(api_key)\n",
    "        if st.session_state.api_key_valid:\n",
    "            st.markdown(\\'<div class=\"status-card\"><div class=\"status-dot dot-green\"></div>API Key validated</div>\\', unsafe_allow_html=True)\n",
    "        else:\n",
    "            st.markdown(\\'<div class=\"status-card\"><div class=\"status-dot dot-yellow\"></div>Key format unrecognised</div>\\', unsafe_allow_html=True)\n",
    "    else:\n",
    "        st.markdown(\\'<div class=\"status-card\"><div class=\"status-dot dot-red\"></div>No API key provided</div>\\', unsafe_allow_html=True)\n",
    "\n",
    "    st.markdown(\"---\")\n",
    "    st.markdown(\"### ⚙️ RAG Settings\")\n",
    "    model_choice  = st.selectbox(\"LLM Model\",\n",
    "        [\"llama3-70b-8192\", \"llama3-8b-8192\", \"mixtral-8x7b-32768\", \"gemma2-9b-it\"], index=0)\n",
    "    chunk_size    = st.slider(\"Chunk Size\", 200, 1000, 500, 50)\n",
    "    chunk_overlap = st.slider(\"Chunk Overlap\", 0, 200, 50, 10)\n",
    "    top_k         = st.slider(\"Top-K Retrieval\", 1, 10, 4)\n",
    "    temperature   = st.slider(\"LLM Temperature\", 0.0, 1.0, 0.2, 0.05)\n",
    "\n",
    "    st.markdown(\"---\")\n",
    "    st.markdown(\"### 📂 Upload Documents\")\n",
    "    uploaded_files = st.file_uploader(\"Drop PDFs or TXT files here\",\n",
    "                                      type=[\"pdf\", \"txt\"], accept_multiple_files=True)\n",
    "\n",
    "    col1, col2 = st.columns(2)\n",
    "    with col1:\n",
    "        process_btn = st.button(\"⚡ Process\", use_container_width=True,\n",
    "                                disabled=not uploaded_files)\n",
    "    with col2:\n",
    "        clear_btn = st.button(\"🗑️ Clear All\", use_container_width=True)\n",
    "\n",
    "    if clear_btn:\n",
    "        st.session_state.messages      = []\n",
    "        st.session_state.vector_store  = None\n",
    "        st.session_state.rag_chain     = None\n",
    "        st.session_state.doc_metadata  = []\n",
    "        st.session_state.total_chunks  = 0\n",
    "        st.rerun()\n",
    "\n",
    "    if st.session_state.doc_metadata:\n",
    "        st.markdown(\"---\")\n",
    "        st.markdown(\"### 📊 Index Status\")\n",
    "        n_docs   = len(st.session_state.doc_metadata)\n",
    "        n_chunks = st.session_state.total_chunks\n",
    "        n_qa     = len(st.session_state.messages) // 2\n",
    "        st.markdown(f\\'\\'\\'<div class=\"metric-row\">\n",
    "            <div class=\"metric-card\"><div class=\"metric-value\">{n_docs}</div><div class=\"metric-label\">Docs</div></div>\n",
    "            <div class=\"metric-card\"><div class=\"metric-value\">{n_chunks}</div><div class=\"metric-label\">Chunks</div></div>\n",
    "            <div class=\"metric-card\"><div class=\"metric-value\">{n_qa}</div><div class=\"metric-label\">Q&amp;A</div></div>\n",
    "        </div>\\'\\'\\', unsafe_allow_html=True)\n",
    "        for doc in st.session_state.doc_metadata:\n",
    "            st.markdown(f\\'<div class=\"status-card\" style=\"font-size:.8rem;\"><div class=\"status-dot dot-green\"></div>\\'\n",
    "                        f\\'<span><b>{doc[\"name\"]}</b><br><span style=\"color:var(--text-muted)\">{doc[\"chunks\"]} chunks · {doc[\"size\"]}</span></span></div>\\',\n",
    "                        unsafe_allow_html=True)\n",
    "\n",
    "    st.markdown(\"---\")\n",
    "    with st.expander(\"ℹ️ How RAG Works\"):\n",
    "        st.markdown(\"\"\"**RAG** = Retrieval + Generation:\\n\\n\"\"\"\n",
    "                    \"1. **Ingest** – Documents split into overlapping chunks\\n\"\n",
    "                    \"2. **Embed** – Chunks encoded via MiniLM-L6-v2\\n\"\n",
    "                    \"3. **Index** – Vectors stored in FAISS\\n\"\n",
    "                    \"4. **Query** – Top-K similar chunks retrieved\\n\"\n",
    "                    \"5. **Generate** – LLaMA 3 answers using retrieved context\")\n",
    "\n",
    "\n",
    "# ── Document Processing ───────────────────────────────────────────────────────\n",
    "if process_btn and uploaded_files:\n",
    "    if not api_key:\n",
    "        st.error(\"⛔ Please enter a Groq API key in the sidebar first.\")\n",
    "    else:\n",
    "        with st.spinner(\"Processing documents…\"):\n",
    "            try:\n",
    "                processor    = DocumentProcessor(chunk_size=chunk_size, chunk_overlap=chunk_overlap)\n",
    "                vs_manager   = VectorStoreManager()\n",
    "                all_chunks   = []\n",
    "                doc_metadata = []\n",
    "                progress = st.progress(0, text=\"Extracting text…\")\n",
    "                for i, f in enumerate(uploaded_files):\n",
    "                    progress.progress(i / len(uploaded_files), text=f\"Processing {f.name}…\")\n",
    "                    chunks = processor.process_file(f)\n",
    "                    all_chunks.extend(chunks)\n",
    "                    doc_metadata.append({\"name\": f.name, \"chunks\": len(chunks),\n",
    "                                         \"size\": f\"{round(f.size/1024,1)} KB\"})\n",
    "                progress.progress(0.85, text=\"Building FAISS index…\")\n",
    "                vector_store = vs_manager.create_from_chunks(all_chunks)\n",
    "                progress.progress(0.95, text=\"Initialising RAG chain…\")\n",
    "                rag_chain = RAGChain(vector_store=vector_store, model_name=model_choice,\n",
    "                                     top_k=top_k, temperature=temperature)\n",
    "                progress.progress(1.0, text=\"Done!\"); time.sleep(0.4); progress.empty()\n",
    "                st.session_state.vector_store = vector_store\n",
    "                st.session_state.rag_chain    = rag_chain\n",
    "                st.session_state.doc_metadata = doc_metadata\n",
    "                st.session_state.total_chunks = len(all_chunks)\n",
    "                st.session_state.messages     = []\n",
    "                st.success(f\"✅ Indexed **{len(all_chunks)} chunks** from **{len(uploaded_files)} document(s)**. Start chatting!\")\n",
    "                st.rerun()\n",
    "            except Exception as e:\n",
    "                st.error(f\"❌ Processing failed: {e}\")\n",
    "\n",
    "\n",
    "# ── Main Area ─────────────────────────────────────────────────────────────────\n",
    "st.markdown(\\'\\'\\'<div class=\"app-header\">\n",
    "    <p class=\"app-title\">🧠 DocuMind</p>\n",
    "    <p class=\"app-subtitle\">RAG-Powered Document Intelligence · Ask anything about your uploaded files</p>\n",
    "    <span class=\"badge\">RAG</span>\n",
    "    <span class=\"badge\">LLaMA 3</span>\n",
    "    <span class=\"badge\">FAISS</span>\n",
    "    <span class=\"badge\">Semantic Search</span>\n",
    "</div>\\'\\'\\', unsafe_allow_html=True)\n",
    "\n",
    "if not st.session_state.vector_store:\n",
    "    st.markdown(\\'\\'\\'<div style=\"text-align:center;padding:60px 20px;color:var(--text-muted);\">\n",
    "        <div style=\"font-size:3.5rem;margin-bottom:16px;\">📄</div>\n",
    "        <div style=\"font-family:\\'Syne\\',sans-serif;font-size:1.25rem;font-weight:700;color:var(--text-primary);margin-bottom:8px;\">No documents indexed yet</div>\n",
    "        <div style=\"font-size:.9rem;max-width:360px;margin:0 auto;line-height:1.6;\">Upload <strong>PDF</strong> or <strong>TXT</strong> files from the sidebar, then click <em>⚡ Process</em>.</div>\n",
    "    </div>\\'\\'\\', unsafe_allow_html=True)\n",
    "else:\n",
    "    for msg in st.session_state.messages:\n",
    "        role    = msg[\"role\"]\n",
    "        content = msg[\"content\"]\n",
    "        sources = msg.get(\"sources\", [])\n",
    "        if role == \"user\":\n",
    "            st.markdown(f\\'\\'\\'<div class=\"chat-message\" style=\"flex-direction:row-reverse\">\n",
    "                <div class=\"chat-avatar avatar-user\">👤</div>\n",
    "                <div class=\"chat-bubble user\">{content}</div>\n",
    "            </div>\\'\\'\\', unsafe_allow_html=True)\n",
    "        else:\n",
    "            chips = \\'\\'.join(f\\'<span class=\"source-chip\">📄 {s}</span>\\' for s in sources)\n",
    "            sources_html = (f\\'<div class=\"sources-container\"><div class=\"source-label\">Sources</div>{chips}</div>\\'\n",
    "                            if sources else \"\")\n",
    "            st.markdown(f\\'\\'\\'<div class=\"chat-message\">\n",
    "                <div class=\"chat-avatar avatar-bot\">🤖</div>\n",
    "                <div class=\"chat-bubble\">{content}{sources_html}</div>\n",
    "            </div>\\'\\'\\', unsafe_allow_html=True)\n",
    "\n",
    "    user_query = st.chat_input(\"Ask a question about your documents…\")\n",
    "    if user_query and st.session_state.rag_chain:\n",
    "        st.session_state.messages.append({\"role\": \"user\", \"content\": user_query})\n",
    "        with st.spinner(\"Thinking…\"):\n",
    "            try:\n",
    "                result  = st.session_state.rag_chain.query(\n",
    "                    question=user_query,\n",
    "                    chat_history=st.session_state.messages[:-1]\n",
    "                )\n",
    "                answer  = result[\"answer\"]\n",
    "                sources = format_source_references(result.get(\"source_documents\", []))\n",
    "                st.session_state.messages.append({\"role\": \"assistant\", \"content\": answer, \"sources\": sources})\n",
    "            except Exception as e:\n",
    "                st.session_state.messages.append({\"role\": \"assistant\",\n",
    "                    \"content\": f\"⚠️ Error: {str(e)}\", \"sources\": []})\n",
    "        st.rerun()\n",
    "\n",
    "    if not st.session_state.messages:\n",
    "        st.markdown(\\'<div style=\"margin-top:20px;color:var(--text-muted);font-size:.85rem;text-align:center;letter-spacing:.05em;text-transform:uppercase;font-weight:600;\">Suggested prompts</div>\\', unsafe_allow_html=True)\n",
    "        cols = st.columns(2)\n",
    "        suggestions = [\"Summarise the key topics\", \"What are the main conclusions?\",\n",
    "                       \"List the important definitions\", \"What problems does this address?\"]\n",
    "        for i, sug in enumerate(suggestions):\n",
    "            with cols[i % 2]:\n",
    "                if st.button(sug, key=f\"sug_{i}\", use_container_width=True):\n",
    "                    st.session_state.messages.append({\"role\": \"user\", \"content\": sug})\n",
    "                    with st.spinner(\"Thinking…\"):\n",
    "                        result  = st.session_state.rag_chain.query(question=sug, chat_history=[])\n",
    "                        answer  = result[\"answer\"]\n",
    "                        sources = format_source_references(result.get(\"source_documents\", []))\n",
    "                        st.session_state.messages.append({\"role\":\"assistant\",\"content\":answer,\"sources\":sources})\n",
    "                    st.rerun()\n",
    "'''\n",
    "\n",
    "with open('rag_chatbot/app.py', 'w') as f:\n",
    "    f.write(app_code)\n",
    "print(\"✅ app.py written\")\n",
    "print(\"\\n🎉 All project files are ready!\")"
   ]
