    "# ── Write utils/helpers.py ────────────────────────────────────────────────────\n",
    "helpers_code = '''\n",
    "from typing import List\n",
    "from langchain.schema import Document\n",
    "\n",
    "def format_source_references(documents: List[Document]) -> List[str]:\n",
    "    seen, result = set(), []\n",
    "    for doc in documents:\n",
    "        source = doc.metadata.get(\"source\", \"Unknown\")\n",
    "        if source not in seen:\n",
    "            seen.add(source)\n",
    "            result.append(source)\n",
    "    return result\n",
    "\n",
    "def validate_api_key(key: str) -> bool:\n",
    "    return isinstance(key, str) and key.startswith(\"gsk_\") and len(key) > 20\n",
    "'''\n",
    "\n",
    "with open('rag_chatbot/utils/helpers.py', 'w') as f:\n",
    "    f.write(helpers_code)\n",
    "print(\"✅ helpers.py written\")"
   ]
