    "[data-testid=\"stSidebar\"]{background:var(--bg-secondary)!important;border-right:1px solid var(--border);}\n",
    ".stButton>button{background:linear-gradient(135deg,var(--accent) 0%,#8b5cf6 100%)!important;color:white!important;border:none!important;border-radius:8px!important;font-family:\\'DM Sans\\',sans-serif!important;font-weight:500!important;transition:all .2s ease!important;box-shadow:0 4px 15px var(--accent-glow)!important;}\n",
