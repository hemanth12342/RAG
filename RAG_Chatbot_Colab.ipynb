    "# ── Write rag/llm_chain.py ────────────────────────────────────────────────────\n",
    "llm_chain_code = '''\n",
    "from __future__ import annotations\n",
    "import os\n",
    "from typing import Any, Dict, List\n",
    "from langchain.schema import Document\n",
    "from langchain_community.vectorstores import FAISS\n",
    "from langchain_groq import ChatGroq\n",
    "from langchain.schema.messages import HumanMessage, AIMessage, SystemMessage\n",
    "\n",
    "CONTEXTUALISE_SYSTEM = \"\"\"You are a query-reformulation assistant. Given a chat \\\n",
    "history and a follow-up question, rewrite the follow-up question so it is fully \\\n",
    "self-contained. If already self-contained, return it unchanged. Return ONLY the \\\n",
    "rewritten question.\"\"\"\n",
    "\n",
    "QA_SYSTEM = \"\"\"You are DocuMind, an expert document analyst and Q&A assistant. \\\n",
    "Answer the user\\'s question exclusively based on the retrieved context below. \\\n",
    "Be accurate, concise, and well-structured. \\\n",
    "If the answer is not in the context, say so honestly.\\n\\n\\\n",
    "────────────────────────────────────────────\\n\\\n",
    "RETRIEVED CONTEXT\\n\\\n",
    "────────────────────────────────────────────\\n\\\n",
    "{context}\\n\\\n",
    "────────────────────────────────────────────\"\"\"\n",
    "\n",
    "\n",
    "class RAGChain:\n",
    "    def __init__(self, vector_store: FAISS, model_name: str = \"llama3-70b-8192\",\n",
    "                 top_k: int = 4, temperature: float = 0.2):\n",
    "        self.vector_store = vector_store\n",
    "        self.top_k        = top_k\n",
    "        api_key = os.environ.get(\"GROQ_API_KEY\", \"\")\n",
    "        if not api_key:\n",
    "            raise EnvironmentError(\"GROQ_API_KEY is not set.\")\n",
    "        self.llm = ChatGroq(model_name=model_name, temperature=temperature,\n",
    "                            groq_api_key=api_key, max_tokens=1024)\n",
    "\n",
    "    def query(self, question: str, chat_history: List[Dict[str, Any]] | None = None) -> Dict[str, Any]:\n",
    "        chat_history = chat_history or []\n",
    "        rewritten_query  = self._contextualise_question(question, chat_history)\n",
    "        source_documents = self.vector_store.similarity_search(rewritten_query, k=self.top_k)\n",
    "        context          = self._format_context(source_documents)\n",
    "        answer           = self._generate_answer(question, context, chat_history)\n",
    "        return {\"answer\": answer, \"source_documents\": source_documents, \"rewritten_query\": rewritten_query}\n",
    "\n",
    "    def _contextualise_question(self, question: str, chat_history: List[Dict[str, Any]]) -> str:\n",
    "        if not chat_history:\n",
    "            return question\n",
    "        messages = [SystemMessage(content=CONTEXTUALISE_SYSTEM)]\n",
    "        for msg in chat_history[-6:]:\n",
    "            if msg.get(\"role\") == \"user\":\n",
    "                messages.append(HumanMessage(content=msg.get(\"content\", \"\")))\n",
    "            else:\n",
    "                messages.append(AIMessage(content=msg.get(\"content\", \"\")))\n",
    "        messages.append(HumanMessage(content=f\"Follow-up: {question}\"))\n",
    "        try:\n",
    "            return self.llm.invoke(messages).content.strip() or question\n",
    "        except Exception:\n",
    "            return question\n",
    "\n",
    "    def _generate_answer(self, question: str, context: str,\n",
    "                         chat_history: List[Dict[str, Any]]) -> str:\n",
    "        messages = [SystemMessage(content=QA_SYSTEM.format(context=context))]\n",
    "        for msg in chat_history[-6:]:\n",
    "            role = msg.get(\"role\")\n",
    "            content = msg.get(\"content\", \"\")\n",
    "            if role == \"user\":\n",
    "                messages.append(HumanMessage(content=content))\n",
    "            elif role == \"assistant\":\n",
    "                messages.append(AIMessage(content=content))\n",
    "        messages.append(HumanMessage(content=question))\n",
    "        return self.llm.invoke(messages).content.strip()\n",
    "\n",
    "    @staticmethod\n",
    "    def _format_context(documents: List[Document]) -> str:\n",
    "        if not documents:\n",
    "            return \"No relevant context found.\"\n",
    "        parts = []\n",
    "        for i, doc in enumerate(documents, start=1):\n",
    "            source  = doc.metadata.get(\"source\", \"Unknown\")\n",
    "            content = doc.page_content.strip()\n",
    "            parts.append(f\"[Chunk {i} — Source: {source}]\\\\n{content}\")\n",
    "        return \"\\\\n\\\\n\".join(parts)\n",
    "'''\n",
    "\n",
    "with open('rag_chatbot/rag/llm_chain.py', 'w') as f:\n",
    "    f.write(llm_chain_code)\n",
    "print(\"✅ llm_chain.py written\")"
   ]
  },
