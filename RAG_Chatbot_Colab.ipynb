    "# ── Write app.py (main Streamlit application) ─────────────────────────────────\n",
    "app_code = r'''\n",
    "import streamlit as st\n",
    "import os\n",
    "import sys\n",
    "import time\n",
    "\n",
    "# Make rag_chatbot importable when run from inside the directory\n",
    "sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\n",
    "\n",
    "from rag.document_processor import DocumentProcessor\n",
    "from rag.vector_store import VectorStoreManager\n",
    "from rag.llm_chain import RAGChain\n",
    "from utils.helpers import format_source_references, validate_api_key\n",
    "\n",
    "st.set_page_config(\n",
    "    page_title=\"DocuMind – RAG Chatbot\",\n",
    "    page_icon=\"🧠\",\n",
    "    layout=\"wide\",\n",
    "    initial_sidebar_state=\"expanded\",\n",
    ")\n",
    "\n",
    "st.markdown(\"\"\"\n",
    "<style>\n",
    "@import url(\\'https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500&display=swap\\');\n",
    ":root {\n",
    "    --bg-primary:#0e0f1a; --bg-secondary:#161728; --bg-card:#1e2035;\n",
    "    --accent:#6c63ff; --accent-glow:rgba(108,99,255,.25); --accent-2:#ff6b9d;\n",
    "    --text-primary:#e8e9f3; --text-muted:#7b7d9a; --border:rgba(108,99,255,.2);\n",
    "    --success:#4ecca3; --warning:#ffd166; --radius:12px;\n",
    "}\n",
    "html,body,[class*=\"css\"]{ font-family:\\'DM Sans\\',sans-serif; background:var(--bg-primary); color:var(--text-primary); }\n",
    "#MainMenu,footer,header{visibility:hidden;}\n",
    ".app-header{background:linear-gradient(135deg,var(--bg-secondary) 0%,#1a1b2e 100%);border:1px solid var(--border);border-radius:var(--radius);padding:28px 32px;margin-bottom:24px;position:relative;overflow:hidden;}\n",
    ".app-header::before{content:\\'\\';position:absolute;top:-60px;right:-60px;width:200px;height:200px;background:radial-gradient(circle,var(--accent-glow) 0%,transparent 70%);}\n",
    ".app-title{font-family:\\'Syne\\',sans-serif;font-size:2rem;font-weight:800;background:linear-gradient(135deg,#fff 30%,var(--accent) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin:0;line-height:1.1;}\n",
