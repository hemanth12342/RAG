    "## 🚀 Cell 4 — Launch Streamlit via ngrok"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import subprocess\n",
    "import threading\n",
    "import time\n",
    "from pyngrok import ngrok\n",
    "from IPython.display import display, HTML\n",
    "\n",
    "PORT = 8501\n",
    "\n",
    "# ── Kill any existing Streamlit / ngrok processes ────────────────────────────\n",
    "!pkill -f streamlit 2>/dev/null; sleep 1\n",
    "ngrok.kill()\n",
    "\n",
    "# ── Start Streamlit in background ────────────────────────────────────────────\n",
    "streamlit_proc = subprocess.Popen(\n",
    "    [\n",
    "        \"streamlit\", \"run\", \"rag_chatbot/app.py\",\n",
    "        \"--server.port\", str(PORT),\n",
    "        \"--server.headless\", \"true\",\n",
    "        \"--server.enableCORS\", \"false\",\n",
    "        \"--server.enableXsrfProtection\", \"false\",\n",
    "        \"--browser.gatherUsageStats\", \"false\",\n",
    "    ],\n",
    "    stdout=subprocess.PIPE,\n",
    "    stderr=subprocess.STDOUT,\n",
    ")\n",
    "\n",
    "print(\"⏳ Starting Streamlit server…\")\n",
    "time.sleep(5)\n",
    "\n",
    "# ── Open ngrok tunnel ─────────────────────────────────────────────────────────\n",
    "tunnel = ngrok.connect(PORT, \"http\")\n",
    "public_url = tunnel.public_url\n",
    "\n",
    "print(f\"\\n{'='*60}\")\n",
    "print(f\"  🧠 DocuMind RAG Chatbot is LIVE!\")\n",
    "print(f\"{'='*60}\")\n",
    "print(f\"  🔗 Public URL: {public_url}\")\n",
    "print(f\"{'='*60}\")\n",
    "print(\"  Click the link above to open your chatbot in a new tab.\")\n",
    "print(\"  Keep this cell running — closing it will stop the app.\")\n",
    "print(f\"{'='*60}\\n\")\n",
    "\n",
    "display(HTML(f\"\"\"\n",
    "<div style=\"\n",
    "    background: linear-gradient(135deg, #161728, #1e2035);\n",
    "    border: 1px solid rgba(108,99,255,0.3);\n",
    "    border-radius: 12px;\n",
    "    padding: 24px 28px;\n",
    "    margin: 16px 0;\n",
    "    font-family: 'Segoe UI', sans-serif;\n",
    "\">\n",
    "    <div style=\"font-size:1.4rem; font-weight:800; color:#e8e9f3; margin-bottom:8px;\">🧠 DocuMind is Running!</div>\n",
    "    <div style=\"color:#7b7d9a; font-size:0.9rem; margin-bottom:16px;\">\n",
    "        Your RAG chatbot is live. Click the button below to open it.\n",
    "    </div>\n",
    "    <a href=\"{public_url}\" target=\"_blank\" style=\"\n",
    "        display: inline-block;\n",
    "        background: linear-gradient(135deg, #6c63ff, #8b5cf6);\n",
    "        color: white;\n",
    "        text-decoration: none;\n",
    "        padding: 12px 28px;\n",
    "        border-radius: 8px;\n",
    "        font-weight: 600;\n",
    "        font-size: 1rem;\n",
    "        box-shadow: 0 4px 15px rgba(108,99,255,0.4);\n",
    "    \">🚀 Open DocuMind &rarr;</a>\n",
    "    <div style=\"margin-top:16px; color:#7b7d9a; font-size:0.8rem;\">\n",
    "        URL: <code style=\"color:#a89eff;\">{public_url}</code>\n",
    "    </div>\n",
    "</div>\n",
    "\"\"\"))\n",
    "\n",
    "# ── Stream Streamlit logs (optional – shows activity in notebook) ─────────────\n",
    "def stream_logs():\n",
    "    for line in streamlit_proc.stdout:\n",
    "        decoded = line.decode('utf-8', errors='ignore').rstrip()\n",
    "        if decoded and not decoded.startswith('  '):\n",
    "            print(f\"[Streamlit] {decoded}\")\n",
    "\n",
    "log_thread = threading.Thread(target=stream_logs, daemon=True)\n",
    "log_thread.start()\n",
    "\n",
    "# Keep alive\n",
    "try:\n",
    "    streamlit_proc.wait()\n",
    "except KeyboardInterrupt:\n",
    "    print(\"\\n🛑 Shutting down…\")\n",
    "    streamlit_proc.terminate()\n",
    "    ngrok.kill()"
   ]
