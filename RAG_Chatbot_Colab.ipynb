    "# ── Write rag/vector_store.py ─────────────────────────────────────────────────\n",
    "vector_store_code = '''\n",
    "from typing import List, Optional\n",
    "from langchain.schema import Document\n",
    "from langchain_community.vectorstores import FAISS\n",
    "from langchain_huggingface import HuggingFaceEmbeddings\n",
    "\n",
    "EMBEDDING_MODEL_NAME = \"sentence-transformers/all-MiniLM-L6-v2\"\n",
    "\n",
    "\n",
    "class VectorStoreManager:\n",
    "    def __init__(self, model_name: str = EMBEDDING_MODEL_NAME):\n",
    "        self.embeddings = HuggingFaceEmbeddings(\n",
    "            model_name=model_name,\n",
    "            model_kwargs={\"device\": \"cuda\" if self._cuda_available() else \"cpu\"},\n",
    "            encode_kwargs={\"normalize_embeddings\": True},\n",
    "        )\n",
    "        self._vector_store: Optional[FAISS] = None\n",
    "\n",
    "    @staticmethod\n",
    "    def _cuda_available() -> bool:\n",
    "        try:\n",
    "            import torch\n",
    "            return torch.cuda.is_available()\n",
    "        except ImportError:\n",
    "            return False\n",
    "\n",
    "    def create_from_chunks(self, chunks: List[Document]) -> FAISS:\n",
    "        if not chunks:\n",
    "            raise ValueError(\"Cannot build a vector store from an empty chunk list.\")\n",
    "        self._vector_store = FAISS.from_documents(documents=chunks, embedding=self.embeddings)\n",
    "        return self._vector_store\n",
    "\n",
    "    def similarity_search(self, query: str, k: int = 4) -> List[Document]:\n",
    "        if self._vector_store is None:\n",
    "            raise RuntimeError(\"Vector store not initialised.\")\n",
    "        return self._vector_store.similarity_search(query, k=k)\n",
    "\n",
    "    @property\n",
    "    def store(self) -> Optional[FAISS]:\n",
    "        return self._vector_store\n",
    "'''\n",
    "\n",
    "with open('rag_chatbot/rag/vector_store.py', 'w') as f:\n",
    "    f.write(vector_store_code)\n",
    "print(\"✅ vector_store.py written\")"
   ]
  },
