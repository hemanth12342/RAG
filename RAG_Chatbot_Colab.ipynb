    "# ── Write rag/document_processor.py ─────────────────────────────────────────\n",
    "doc_processor_code = '''\n",
    "import io\n",
    "import re\n",
    "from typing import List\n",
    "from langchain.schema import Document\n",
    "from langchain.text_splitter import RecursiveCharacterTextSplitter\n",
    "\n",
    "\n",
    "class DocumentProcessor:\n",
    "    def __init__(self, chunk_size: int = 500, chunk_overlap: int = 50):\n",
    "        self.splitter = RecursiveCharacterTextSplitter(\n",
    "            chunk_size=chunk_size,\n",
    "            chunk_overlap=chunk_overlap,\n",
    "            length_function=len,\n",
    "            separators=[\"\\\\n\\\\n\", \"\\\\n\", \". \", \" \", \"\"],\n",
    "        )\n",
    "\n",
    "    def process_file(self, uploaded_file) -> List[Document]:\n",
    "        file_bytes = uploaded_file.read()\n",
    "        filename   = uploaded_file.name\n",
    "        if filename.lower().endswith(\".pdf\"):\n",
    "            raw_text = self._extract_pdf(file_bytes, filename)\n",
    "        elif filename.lower().endswith(\".txt\"):\n",
    "            raw_text = self._extract_txt(file_bytes, filename)\n",
    "        else:\n",
    "            raise ValueError(f\"Unsupported file type: {filename}\")\n",
    "        raw_text = self._clean_text(raw_text)\n",
    "        return self._split_into_chunks(raw_text, source=filename)\n",
    "\n",
    "    def _extract_pdf(self, file_bytes: bytes, filename: str) -> str:\n",
    "        try:\n",
    "            import fitz\n",
    "            doc  = fitz.open(stream=file_bytes, filetype=\"pdf\")\n",
    "            text = \"\"\n",
    "            for page_num, page in enumerate(doc, start=1):\n",
    "                page_text = page.get_text(\"text\")\n",
    "                if page_text.strip():\n",
    "                    text += f\"\\\\n[Page {page_num}]\\\\n{page_text}\"\n",
    "            doc.close()\n",
    "            if not text.strip():\n",
    "                raise ValueError(\"PDF appears to be image-only / scanned.\")\n",
    "            return text\n",
    "        except ImportError:\n",
    "            from pypdf import PdfReader\n",
    "            reader = PdfReader(io.BytesIO(file_bytes))\n",
    "            text   = \"\"\n",
    "            for i, page in enumerate(reader.pages, start=1):\n",
    "                extracted = page.extract_text() or \"\"\n",
    "                if extracted.strip():\n",
    "                    text += f\"\\\\n[Page {i}]\\\\n{extracted}\"\n",
    "            return text\n",
    "\n",
    "    def _extract_txt(self, file_bytes: bytes, filename: str) -> str:\n",
    "        for encoding in (\"utf-8\", \"utf-16\", \"latin-1\", \"cp1252\"):\n",
    "            try:\n",
    "                return file_bytes.decode(encoding)\n",
    "            except (UnicodeDecodeError, LookupError):\n",
    "                continue\n",
    "        raise ValueError(f\"Could not decode {filename}.\")\n",
    "\n",
    "    @staticmethod\n",
    "    def _clean_text(text: str) -> str:\n",
    "        text = re.sub(r\"\\\\n{3,}\", \"\\\\n\\\\n\", text)\n",
    "        text = re.sub(r\"[ \\\\t]{2,}\", \" \", text)\n",
    "        return text.strip()\n",
    "\n",
    "    def _split_into_chunks(self, text: str, source: str) -> List[Document]:\n",
    "        raw_chunks = self.splitter.split_text(text)\n",
    "        documents  = []\n",
    "        for i, chunk in enumerate(raw_chunks):\n",
    "            if chunk.strip():\n",
    "                documents.append(Document(\n",
    "                    page_content=chunk,\n",
    "                    metadata={\"source\": source, \"chunk_id\": i, \"chunk_count\": len(raw_chunks)},\n",
    "                ))\n",
    "        return documents\n",
    "'''\n",
    "\n",
    "with open('rag_chatbot/rag/document_processor.py', 'w') as f:\n",
    "    f.write(doc_processor_code)\n",
    "print(\"✅ document_processor.py written\")"
   ]
  },
